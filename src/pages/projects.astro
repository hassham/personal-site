---
import BaseLayout from '../layouts/BaseLayout.astro';

const projects = [
  {
    title: 'Broadcast Monitoring System',
    description: 'A system for monitoring and measuring broadcast advertisements against program and content schedules. Built with Awasi.',
    link: '#',
  },
  {
    title: 'TV Audience Measurement',
    description: 'A TV audience measurement system that captures viewing data from devices installed in homes across the country. Built with Awasi.',
    link: '#',
  },
];
---
<BaseLayout title="Projects — Hasham Ahmad">
  <h1>Projects</h1>
  <ul class="project-list">
    {projects.map((project) => (
      <li>
        <a href={project.link}>{project.title}</a>
        <p>{project.description}</p>
      </li>
    ))}
  </ul>
</BaseLayout>
